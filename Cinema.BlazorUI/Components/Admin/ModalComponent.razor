@namespace Cinema.BlazorUI.Components
@code {
    private bool showModal = false;
    private string modalMessage = string.Empty;
    private string modalClass = "success";

    public void ShowModal(string message, string type)
    {
        modalMessage = message;
        modalClass = type;
        showModal = true;
        StateHasChanged(); // Force UI update
    }

    public void CloseModal()
    {
        showModal = false;
        StateHasChanged(); // Force UI update
    }
}

<div class="modal @(showModal ? "show" : "")" @onclick="CloseModal">
    <div class="modal-content" @onclick:stopPropagation>
        <span class="close" @onclick="CloseModal">&times;</span>
        <p class="@modalClass">@modalMessage</p>
    </div>
</div>

<style>
    .modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

        .modal.show {
            display: flex !important;
        }

    .modal-content {
        background-color: white;
        padding: 20px;
        border-radius: 5px;
        text-align: center;
        position: relative;
        min-width: 300px;
    }

    .success {
        color: green;
        font-weight: bold;
    }

    .failure {
        color: red;
        font-weight: bold;
    }

    .close {
        position: absolute;
        top: 10px;
        right: 15px;
        cursor: pointer;
        font-size: 24px;
    }

        .close:hover {
            color: #666;
        }
</style>