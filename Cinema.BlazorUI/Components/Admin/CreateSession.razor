@using Cinema.BlazorUI.Model
@namespace Cinema.BlazorUI.Components.Admin


<div class="admin-action">
    <div class="admin-action-title">@Title</div>
    
    <div class="admin-action-form">
        <div class="admin-action-form-group">
            <label>Movie ID</label>
            <input type="number" 
                class="admin-action-form-group-control"
                @bind="MovieId"
                placeholder="Enter movie ID"/>
        </div>

        <div class="admin-action-form-block">
            @* <label>Dates</label> *@
            @for (int i = 0; i < Sessions.Count; i++)
            {
                var index = i;

                <div class="admin-action-form-block-small">
                    <label for="">Dates</label>
                    <input type="datetime-local" 
                        class="admin-action-form-block-small-control"
                        @bind="Sessions[index].Date"
                        @bind:event="oninput"
                        @onchange="() => HandleSessionChange(index)"
                        placeholder="Select date and time"/>
                </div>

                <div class="admin-action-form-block-small">
                    <label for="">Hall number</label>
                    <input type="number" 
                        class="admin-action-form-block-small-control"
                        @bind="Sessions[index].HallNumber"
                        placeholder="Enter hall number"/>
                </div>

                <div class="admin-action-form-block-small">
                    <label for="">Ticket price</label>
                    <input type="number" 
                        class="admin-action-form-block-small-control"
                        @bind="Sessions[index].TicketPrice"
                        placeholder="Enter ticket price"/>
                </div>
                @* <div class="session-input-container">
                    <input type="datetime-local" 

                        class="admin-action-form-group-control"
                        @bind="Sessions[index].Date"
                        @bind:event="oninput"
                        @onchange="() => HandleSessionChange(index)"
                        placeholder="Select date and time"/>
                    
                    <input type="number" 
                        class="admin-action-form-group-control"
                        @bind="Sessions[index].HallNumber"
                        placeholder="Enter hall number"/>
                        
                    <input type="number" 
                        class="admin-action-form-group-control"
                        @bind="Sessions[index].TicketPrice"
                        placeholder="Enter ticket price"/>
                </div> *@
            }
        </div>

        <div class="buttons">
            <button @onclick="HandleSubmit">
                @(SubmitText ?? "Submit")
            </button>
        </div>
    </div>
</div>

@code {
    public class SessionData
    {
        public int MovieId { get; set; }
        public SessionInfo[] Sessions { get; set; }
    }

    public class SessionInfo
    {
        public DateTime Date { get; set; }
        public int HallNumber { get; set; }
        public double TicketPrice { get; set; }
    }

    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public EventCallback<SessionData> OnSubmit { get; set; }

    [Parameter]
    public string SubmitText { get; set; }

    private int MovieId { get; set; }
    private List<SessionInfo> Sessions { get; set; } = new() 
    { 
        new SessionInfo 
        { 
            Date = DateTime.Now,
            HallNumber = 1,
            TicketPrice = 0
        } 
    };

    private void HandleSessionChange(int index)
    {
        if (index == Sessions.Count - 1)
        {
            Sessions.Add(new SessionInfo 
            { 
                Date = DateTime.Now,
                HallNumber = 1,
                TicketPrice = 0
            });
            StateHasChanged();
        }
    }

    private async Task HandleSubmit()
    {
        var sessionData = new SessionData
        {
            MovieId = MovieId,
            Sessions = Sessions.ToArray()
        };
        await OnSubmit.InvokeAsync(sessionData);
    }
} 